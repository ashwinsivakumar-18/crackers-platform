# ===== Crackers Platform (JS/Mongo) — PRODUCTION env =====
# Copy to repo-root .env on the server and fill every value. Replace yourstore.in.
NODE_ENV=production
PORT=4000
API_URL=https://api.yourstore.in
CORS_ORIGINS=https://yourstore.in,https://admin.yourstore.in,https://crm.yourstore.in

# MongoDB — must match the MONGO_USER/MONGO_PASSWORD below. authSource=admin for root user.
MONGODB_URI=mongodb://CHANGE_ME_USER:CHANGE_ME_PASSWORD@mongo:27017/crackers?authSource=admin

# Redis — must match REDIS_PASSWORD below
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# JWT — generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=PASTE_RANDOM_HEX
JWT_REFRESH_SECRET=PASTE_DIFFERENT_RANDOM_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Object storage (MinIO bundled, or AWS S3 / Cloudflare R2)
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=crackers-media
S3_ACCESS_KEY=CHANGE_ME            # = MINIO_ROOT_USER when using bundled MinIO
S3_SECRET_KEY=CHANGE_ME            # = MINIO_ROOT_PASSWORD
S3_PUBLIC_URL=https://media.yourstore.in

# Where the API stores images when S3/MinIO is NOT configured (persisted by a docker volume)
UPLOADS_DIR=/app/uploads

# WhatsApp (India-registered account). Blank = log instead of send.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

STORE_NAME=Sivakumar Crackers
STORE_UPI_ID=yourstore@okhdfc
SUPPORT_PHONE=91XXXXXXXXXX
MIN_ORDER_AMOUNT=3500
PACK_TRANSPORT_PCT=5


# ===== docker-compose.prod.yml variables (create the containers) =====
MONGO_USER=CHANGE_ME_USER                 # must match MONGODB_URI
MONGO_PASSWORD=CHANGE_ME_PASSWORD         # must match MONGODB_URI
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD   # must match REDIS_URL
MINIO_ROOT_USER=CHANGE_ME                 # = S3_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME             # = S3_SECRET_KEY
VITE_API_URL=https://api.yourstore.in/api/v1   # baked into the web apps at build
