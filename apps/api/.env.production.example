# ============================================================================
#  Sivakumar Crackers — PRODUCTION .env   (Docker Compose)
#  Copy this to a file named  .env  in the REPO ROOT (next to docker-compose.prod.yml)
#  and fill every value. Replace sivakumarcrackers.com with your domain.
#  NOTE: hostnames are the DOCKER SERVICE NAMES (mongo, redis, minio) — do NOT
#  use localhost / 127.0.0.1 here; those don't resolve inside the containers.
# ============================================================================

NODE_ENV=production
PORT=4000
API_URL=https://api.sivakumarcrackers.com
CORS_ORIGINS=https://sivakumarcrackers.com,https://admin.sivakumarcrackers.com

# ---- MongoDB (user/password must match MONGO_USER/MONGO_PASSWORD below) ----
MONGODB_URI=mongodb://crackeradmin:CHANGE_ME_DB_PASSWORD@mongo:27017/crackers?authSource=admin

# ---- Redis (password must match REDIS_PASSWORD below) ----
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# ---- JWT secrets (run this twice, paste each): 
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" ----
JWT_ACCESS_SECRET=PASTE_RANDOM_HEX
JWT_REFRESH_SECRET=PASTE_A_DIFFERENT_RANDOM_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Image storage ----
# SIMPLEST (recommended): leave the three S3_* keys BLANK. Images are stored on the
# API container's disk at UPLOADS_DIR and kept safe by the "apiuploads" docker volume.
# They are served at https://api.sivakumarcrackers.com/uploads/...
# To use MinIO/S3/R2 instead, fill S3_ACCESS_KEY + S3_SECRET_KEY (and expose media).
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=crackers-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
UPLOADS_DIR=/app/uploads

# ---- Your shop ----
STORE_NAME=Sivakumar Crackers
STORE_UPI_ID=6379567928@slc
SUPPORT_PHONE=916379567928
MIN_ORDER_AMOUNT=3500
PACK_TRANSPORT_PCT=5

# Required only for the initial database seed
ADMIN_MOBILE=YOUR_10_DIGIT_ADMIN_MOBILE
ADMIN_PASSWORD=CHOOSE_A_STRONG_ADMIN_PASSWORD

# ============================================================================
#  docker-compose.prod.yml variables (used to CREATE the containers)
# ============================================================================
MONGO_USER=crackeradmin                       # must match MONGODB_URI above
MONGO_PASSWORD=CHANGE_ME_DB_PASSWORD          # must match MONGODB_URI above
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD       # must match REDIS_URL above
MINIO_ROOT_USER=minioadmin                    # only matters if you use MinIO
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD  # only matters if you use MinIO
VITE_API_URL=https://api.sivakumarcrackers.com/api/v1   # baked into the web apps at BUILD time
